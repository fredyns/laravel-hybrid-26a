{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "chrome-devtools": {
            "command": "cmd.exe",
            "args": ["/d", "/c", "npx.cmd", "-y", "chrome-devtools-mcp@latest"]
        }
    }
}
