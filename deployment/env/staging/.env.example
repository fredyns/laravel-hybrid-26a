# Staging environment template.
#
# This file is committed as a reference ONLY — it must never hold real
# credentials.
#
# Secrets are delivered exclusively through GitLab. Fill in a copy of this
# file, then store it in Settings > CI/CD > Variables:
#
#   Key:       STAGING_ENV_FILE
#   Type:      File
#   Protected: yes            (and mark `main` a protected branch)
#   Expand variable reference: no   -- the ${VAR} refs below are for Laravel,
#                                      not for the runner to expand
#   Value:     the whole filled-in file
#
# The deploy job copies it to the server as .env on every deploy. Nothing is
# provisioned on the server by hand, and no server access is needed.
#
# Fill in every __CHANGE_ME__ and set APP_KEY to the key already live on
# staging — a new key invalidates sessions and encrypted values.

APP_NAME="Laravel Kit 2026"
APP_ENV=staging
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://__CHANGE_ME__
APP_PORT=9900

# exposed ports from container services
DB_PORT_EXPOSED=9901
REDIS_PORT_EXPOSED=9902
MINIO_API_PORT_EXPOSED=9903
MINIO_CONSOLE_PORT_EXPOSED=9904
REVERB_PORT_EXPOSED=9905
MAILPIT_SMTP_PORT_EXPOSED=9906
MAILPIT_UI_PORT=9907

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- database (service name on laravelkit26_net) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravelkit26
DB_USERNAME=laravelkit26
DB_PASSWORD=__CHANGE_ME__

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- mail (mailpit on staging) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@__CHANGE_ME__"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_SMTP_PORT=1025

# --- object storage (minio, s3-compatible) ---
AWS_ACCESS_KEY_ID="${MINIO_ACCESS_KEY}"
AWS_SECRET_ACCESS_KEY="${MINIO_SECRET_KEY}"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET="${MINIO_BUCKET_NAME}"
AWS_USE_PATH_STYLE_ENDPOINT=true

MINIO_ROOT_USER=__CHANGE_ME__
MINIO_ROOT_PASSWORD=__CHANGE_ME__
MINIO_ACCESS_KEY=__CHANGE_ME__
MINIO_SECRET_KEY=__CHANGE_ME__
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=laravelkit26
MINIO_DEFAULT_REGION=us-east-1
MINIO_URL=https://__CHANGE_ME__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_PATH_STYLE_ENDPOINT=true

# --- reverb (websockets) ---
REVERB_APP_ID=__CHANGE_ME__
REVERB_APP_KEY=__CHANGE_ME__
REVERB_APP_SECRET=__CHANGE_ME__
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=__CHANGE_ME__
REVERB_PORT=443
REVERB_SCHEME=https

# --- container user (matches `app` uid/gid in deployment/docker/php/Dockerfile) ---
WWWUSER=1000
WWWGROUP=1000

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_API_URL="${APP_URL}/api"
