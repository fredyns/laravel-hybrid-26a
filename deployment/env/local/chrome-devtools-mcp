#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
    pwd
)"

PROJECT_ROOT="$(
    cd -- "$SCRIPT_DIR/../../.." >/dev/null 2>&1
    pwd
)"

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
    printf 'MCP launcher error: NVM tidak ditemukan di %s\n' "$NVM_DIR" >&2
    exit 127
fi

# Memuat perintah nvm.
# shellcheck source=/dev/null
. "$NVM_DIR/nvm.sh"

NODE_VERSION="24.18.0"

if [[ -s "$PROJECT_ROOT/.nvmrc" ]]; then
    NODE_VERSION="$(tr -d '[:space:]' < "$PROJECT_ROOT/.nvmrc")"
fi

if ! nvm use --silent "$NODE_VERSION" >/dev/null; then
    printf 'MCP launcher error: Node.js %s tidak tersedia di NVM.\n' \
        "$NODE_VERSION" >&2
    exit 127
fi

if ! command -v node >/dev/null 2>&1; then
    printf 'MCP launcher error: node tidak ditemukan.\n' >&2
    exit 127
fi

if ! command -v npx >/dev/null 2>&1; then
    printf 'MCP launcher error: npx tidak ditemukan.\n' >&2
    exit 127
fi

# Mode pemeriksaan manual, tidak dipakai oleh PhpStorm.
if [[ "${1:-}" == "--check" ]]; then
    printf 'Project : %s\n' "$PROJECT_ROOT"
    printf 'Node    : %s\n' "$(command -v node)"
    printf 'Npx     : %s\n' "$(command -v npx)"
    node --version
    npx --version
    exit 0
fi

# Jangan mencetak informasi apa pun ke stdout sebelum MCP berjalan.
exec npx -y chrome-devtools-mcp@latest "$@"
